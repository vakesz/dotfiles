# SSH client config. Managed via the dotfiles repository.
#
# Keys themselves are never tracked here; only this file is stowed into ~/.ssh.
#
# ssh uses the FIRST value it finds for each keyword, so every Include stays at
# the top: entries in the included files win over the defaults below.

# Machine-specific hosts that should not be shared across machines.
# Missing files are ignored silently.
Include ~/.ssh/config.local

# Written by container tooling when installed. Listed here (rather than left for
# the tools to append) so they do not rewrite this stowed file.
Include ~/.colima/ssh_config
Include ~/.orbstack/ssh/config

Host github.com
    HostName github.com
    User git
    IdentitiesOnly yes

Host *
    # UseKeychain is macOS-only; IgnoreUnknown keeps Linux ssh from erroring out.
    IgnoreUnknown UseKeychain
    UseKeychain yes
    AddKeysToAgent yes
    ServerAliveInterval 60
    ServerAliveCountMax 3
