diff --git a/scripts/build-ntfs3g.sh b/scripts/build-ntfs3g.sh
index 72f1369..b83aabd 100755
--- a/scripts/build-ntfs3g.sh
+++ b/scripts/build-ntfs3g.sh
@@ -16,0 +17 @@ BUILD_DIR="${TMPDIR:-/tmp}/omnimount-ntfs3g-build"
+FUSE_T_PKGCONFIG_DIR="$BUILD_DIR/pkgconfig"
@@ -19 +20 @@ if [ ! -f /usr/local/lib/libfuse-t.dylib ]; then
-    echo "ERROR: FUSE-T no está instalado." >&2
+    echo "ERROR: FUSE-T is not installed." >&2
@@ -24 +25 @@ fi
-echo "==> Descargando ntfs-3g $NTFS3G_VERSION"
+echo "==> Downloading ntfs-3g $NTFS3G_VERSION"
@@ -27,0 +29,18 @@ TARBALL="ntfs-3g_ntfsprogs-$NTFS3G_VERSION.tgz"
+
+# ntfs-3g's configure requires a FUSE 2 pkg-config entry. FUSE-T exposes
+# the compatible library as fuse-t.pc, so provide a build-local alias rather
+# than changing the system-wide FUSE-T installation.
+mkdir -p "$FUSE_T_PKGCONFIG_DIR"
+cat > "$FUSE_T_PKGCONFIG_DIR/fuse.pc" <<'EOF'
+prefix=/usr/local
+exec_prefix=${prefix}
+libdir=${exec_prefix}/lib
+includedir=${prefix}/include/fuse
+
+Name: fuse
+Description: FUSE-T FUSE 2 compatibility
+Version: 2.9.9
+Libs: -L${libdir} -Wl,-rpath,${libdir} -lfuse-t
+Cflags: -I${includedir}
+EOF
+
@@ -36,2 +55,3 @@ SRC="ntfs-3g-$NTFS3G_VERSION"
-for ARCH in arm64 x86_64; do
-    echo "==> Compilando $ARCH"
+ARCH="${OMNIMOUNT_ARCH:-$(uname -m)}"
+for ARCH in "$ARCH"; do
+    echo "==> Building $ARCH"
@@ -43 +63 @@ for ARCH in arm64 x86_64; do
-    PKG_CONFIG_PATH="/usr/local/lib/pkgconfig" \
+    PKG_CONFIG_PATH="$FUSE_T_PKGCONFIG_DIR:/usr/local/lib/pkgconfig" \
@@ -45 +65 @@ for ARCH in arm64 x86_64; do
-    CPPFLAGS="-I/usr/local/include -D_FILE_OFFSET_BITS=64" \
+    CPPFLAGS="-D_FILE_OFFSET_BITS=64" \
@@ -48 +68 @@ for ARCH in arm64 x86_64; do
-                --disable-nls --disable-ldconfig $HOSTFLAG >/dev/null
+                --disable-ldconfig $HOSTFLAG >/dev/null
@@ -56 +76 @@ for pair in ntfs-3g:src/ntfs-3g mkntfs:ntfsprogs/mkntfs ntfsfix:ntfsprogs/ntfsfi
-    lipo -create "$SRC-arm64/$rel" "$SRC-x86_64/$rel" -output "$VENDOR_BIN/$name"
+    cp "$SRC-$ARCH/$rel" "$VENDOR_BIN/$name"
@@ -60 +80 @@ echo ""
-echo "==> Binarios universales en $VENDOR_BIN:"
+echo "==> Native $ARCH binaries in $VENDOR_BIN:"
diff --git a/scripts/make-app.sh b/scripts/make-app.sh
