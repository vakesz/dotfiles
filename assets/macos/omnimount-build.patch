+RELEASE_DIR="$(swift build -c release --arch "$ARCH" \
+    --scratch-path "$SCRATCH" --cache-path "$SCRATCH/cache" --show-bin-path)"
+for product in OmnimountApp OmnimountHelper omnimount; do
+    if [[ ! -x "$RELEASE_DIR/$product" ]]; then
+        echo "ERROR: $product not found in $RELEASE_DIR" >&2
+        exit 1
+    fi
+done
