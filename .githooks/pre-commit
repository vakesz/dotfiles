#!/usr/bin/env bash
# Block commits that add secrets. The repo is public and now holds SSH,
# Claude Code and VS Code config. Enable with: make hooks
set -euo pipefail

if ! command -v gitleaks >/dev/null 2>&1; then
    printf 'pre-commit: gitleaks is not installed; skipping the secret scan\n' >&2
    exit 0
fi

exec gitleaks git --staged --no-banner --redact
