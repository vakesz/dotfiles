[user]
	name = Gabor Pinkova
	email = vakesz@users.noreply.github.com

[core]
	whitespace = trailing-space,cr-at-eol
	# fsmonitor starts a watcher daemon per repo, so turn it on only in large
	# repos: git config core.fsmonitor true
	untrackedcache = true

[apply]
	whitespace = fix

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true
	followTags = true

[init]
	defaultBranch = main

[branch]
	autosetupmerge = simple
	sort = -committerdate

[alias]
	# Fast-forward the current branch from upstream, then push it to origin
	sync-fork = !branch=$(git symbolic-ref --short HEAD) && git fetch upstream && git merge --ff-only upstream/$branch && git push origin $branch
	sf = sync-fork
	lol = log --graph --oneline --decorate --all

[pager]
	difftool = true

[commit]
	verbose = true

[column]
	ui = auto

[credential]
	# Git Credential Manager from the Brewfile (macOS). On Linux HTTPS auth
	# falls back to the store/cache helper in gitconfig.local.
	# An empty value clears helpers inherited from system config (Homebrew git sets osxkeychain).
	helper =
	helper = manager

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[rebase]
	autosquash = true
	autostash = true
	updateRefs = true

[tag]
	sort = version:refname

[rerere]
	enabled = true

[fetch]
	prune = true
	# Keep the commit-graph current so log, merge-base and blame stay fast.
	writeCommitGraph = true
	# 0 picks a sensible number of parallel jobs for multiple remotes.
	parallel = 0

[submodule]
	fetchJobs = 0

[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold

[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://dev.azure.com"]
	useHttpPath = true

# Machine-local overrides. Git skips the file if it doesn't exist.
[include]
	path = gitconfig.local
