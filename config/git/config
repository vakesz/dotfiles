[user]
	name = Gabor Pinkova
	email = vakesz@users.noreply.github.com

[core]
	whitespace = trailing-space,cr-at-eol
	fsmonitor = true
	untrackedcache = true

[apply]
	whitespace = fix

[pull]
	rebase = true

[push]
	default = current
	autoSetupRemote = true

[init]
	defaultBranch = main

[branch]
	autosetupmerge = simple

[alias]
	# Fast-forward the current branch from upstream, then push it to origin
	sync-fork = !branch=$(git symbolic-ref --short HEAD) && git fetch upstream && git merge --ff-only upstream/$branch && git push origin $branch
	sf = sync-fork
	lol = log --graph --oneline --decorate --all

[pager]
	difftool = true

[credential]
	# Git Credential Manager, installed from the Brewfile
	helper = manager

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[rebase]
	autosquash = true
	autostash = true

[rerere]
	enabled = true

[fetch]
	prune = true

[color "branch"]
	current = yellow bold
	local = green bold
	remote = cyan bold

[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true

[credential "https://dev.azure.com"]
	useHttpPath = true

# Machine-local overrides. Git skips the file if it doesn't exist.
[include]
	path = gitconfig.local
