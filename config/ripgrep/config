# Case-insensitive unless the pattern has uppercase letters
--smart-case

# Search hidden files
--hidden

# Skip these. make check-config keeps the list in sync with config/fd/ignore.
--glob=!.git/
--glob=!node_modules/
--glob=!.venv/
--glob=!__pycache__/
--glob=!*.pyc
--glob=!.DS_Store
--glob=!.build/
--glob=!DerivedData/
--glob=!.Trash/
